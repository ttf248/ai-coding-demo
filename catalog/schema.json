{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "plan",
        "amount",
        "unit",
        "batchId",
        "caseCount",
        "note"
      ],
      "properties": {
        "type": {
          "enum": ["subscription", "batch", "run"]
        },
        "provider": {
          "type": ["string", "null"]
        },
        "plan": {
          "type": ["string", "null"]
        },
        "amount": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "unit": {
          "type": ["string", "null"]
        },
        "sourceAmount": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "sourceUnit": {
          "type": ["string", "null"]
        },
        "conversionRate": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["amount", "unit", "perAmount", "perUnit"],
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": "string"
            },
            "perAmount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "perUnit": {
              "type": "string"
            }
          }
        },
        "batchId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "caseCount": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "title",
        "description",
        "category",
        "tags"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/slug"
        },
        "thumbnail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sourceRunId"],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "sourceRunId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "testingStatus": {
          "enum": ["active", "archived"]
        },
        "testingHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "date", "reason"],
            "properties": {
              "status": {
                "enum": ["active", "archived"]
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "complexity": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["level", "reason"],
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["testingStatus"],
            "properties": {
              "testingStatus": {
                "const": "archived"
              }
            }
          },
          "then": {
            "required": ["testingHistory"],
            "properties": {
              "testingHistory": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "topicId",
        "title",
        "previousId",
        "source",
        "extraction",
        "hash"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "topicId": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string"
        },
        "previousId": {
          "type": ["string", "null"]
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "extraction": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "topicId",
        "promptId",
        "title",
        "modelId",
        "effort",
        "date",
        "description",
        "type",
        "status",
        "stack",
        "tags",
        "input",
        "environment",
        "changes",
        "preview",
        "build",
        "links"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+--[a-z0-9-]+$"
        },
        "runId": {
          "$ref": "#/$defs/slug"
        },
        "topicId": {
          "$ref": "#/$defs/slug"
        },
        "promptId": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "$ref": "#/$defs/slug"
        },
        "effort": {
          "$ref": "#/$defs/slug"
        },
        "date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "single-html",
            "prototype",
            "app",
            "fullstack",
            "prompt",
            "other"
          ]
        },
        "status": {
          "enum": ["draft", "ready", "archived"]
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "hash", "completeness", "notes"],
          "properties": {
            "file": {
              "$ref": "#/$defs/path"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "completeness": {
              "enum": ["partial", "recorded", "unknown"]
            },
            "executionMode": {
              "enum": ["design-enhanced", "strict", "unknown"]
            },
            "authorization": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "notes"],
          "properties": {
            "tool": {
              "type": ["string", "null"]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pages",
            "defaultPage",
            "network",
            "embed",
            "externalUrl"
          ],
          "properties": {
            "kind": {
              "enum": ["static", "build", "external", "none"]
            },
            "network": {
              "enum": ["offline", "required", "unknown"]
            },
            "embed": {
              "type": "boolean"
            },
            "externalUrl": {
              "type": ["string", "null"]
            },
            "defaultPage": {
              "type": ["string", "null"]
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "path"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/slug"
                  },
                  "label": {
                    "type": "string"
                  },
                  "path": {
                    "$ref": "#/$defs/path"
                  }
                }
              }
            }
          }
        },
        "screenshot": {
          "$ref": "#/$defs/path"
        },
        "billing": {
          "$ref": "#/$defs/billing"
        },
        "build": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "output"],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                }
              }
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    }
  }
}
