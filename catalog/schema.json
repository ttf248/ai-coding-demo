{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "title",
        "description",
        "category",
        "tags"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/slug"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "topicId",
        "title",
        "previousId",
        "source",
        "extraction",
        "hash"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "topicId": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string"
        },
        "previousId": {
          "type": ["string", "null"]
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "extraction": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "topicId",
        "promptId",
        "title",
        "modelId",
        "effort",
        "date",
        "description",
        "type",
        "status",
        "stack",
        "tags",
        "input",
        "environment",
        "changes",
        "preview",
        "build",
        "links"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+--[a-z0-9-]+$"
        },
        "runId": {
          "$ref": "#/$defs/slug"
        },
        "topicId": {
          "$ref": "#/$defs/slug"
        },
        "promptId": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "$ref": "#/$defs/slug"
        },
        "effort": {
          "$ref": "#/$defs/slug"
        },
        "date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "single-html",
            "prototype",
            "app",
            "fullstack",
            "prompt",
            "other"
          ]
        },
        "status": {
          "enum": ["draft", "ready", "archived"]
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "hash", "completeness", "notes"],
          "properties": {
            "file": {
              "$ref": "#/$defs/path"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "completeness": {
              "enum": ["partial", "recorded", "unknown"]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "notes"],
          "properties": {
            "tool": {
              "type": ["string", "null"]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pages",
            "defaultPage",
            "network",
            "embed",
            "externalUrl"
          ],
          "properties": {
            "kind": {
              "enum": ["static", "build", "external", "none"]
            },
            "network": {
              "enum": ["offline", "required", "unknown"]
            },
            "embed": {
              "type": "boolean"
            },
            "externalUrl": {
              "type": ["string", "null"]
            },
            "defaultPage": {
              "type": ["string", "null"]
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "path"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/slug"
                  },
                  "label": {
                    "type": "string"
                  },
                  "path": {
                    "$ref": "#/$defs/path"
                  }
                }
              }
            }
          }
        },
        "build": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "output"],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "output": {
                  "$ref": "#/$defs/path"
                }
              }
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    }
  }
}
