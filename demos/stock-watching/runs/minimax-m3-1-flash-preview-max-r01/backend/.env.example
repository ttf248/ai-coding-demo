# 复制为 .env 或直接导出为环境变量后运行 `go run .`

# HTTP 端口
PORT=8080

# gin 运行模式：debug / release / test
GIN_MODE=debug

# PostgreSQL 连接串
DATABASE_DSN=host=127.0.0.1 port=5432 user=stockwatch password=stockwatch dbname=stockwatch sslmode=disable TimeZone=UTC

# 是否打印请求与应答日志
LOG_REQUESTS=true

# 跨域白名单，逗号分隔；留空表示允许所有来源（仅建议本地调试使用）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 行情来源：目前实现 simulated，接入真实行情后再扩展
QUOTE_MODE=simulated

# 首次启动是否写入市场与示例代码
SEED_ENABLED=true

# 请求体大小上限（字节）
REQUEST_LIMIT_BYTES=1048576
