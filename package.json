{
  "name": "ai-coding-demo-archive",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "new:demo": "node scripts/new-demo.mjs",
    "demo:sync": "node scripts/demo-sync.mjs",
    "topic:status": "node scripts/topic-status.mjs",
    "topics:active": "node scripts/topic-status.mjs list --json",
    "models:pending": "node scripts/model-ordering.mjs pending",
    "build:demo": "node scripts/build-demo.mjs",
    "review:scores": "node scripts/review-scores.mjs",
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"scripts/*.mjs\" \"assets/*.js\" \"assets/*.css\" \"tests/**/*.mjs\" index.html topic.html compare.html 404.html playwright.config.mjs catalog/schema.json package.json"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@playwright/test": "1.58.2",
    "ajv": "8.17.1",
    "lucide": "1.56.0",
    "markdown-it": "15.0.2",
    "postcss": "8.5.30",
    "prettier": "3.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "vue": "3.5.44"
  }
}
