{
  "name": "ai-coding-demo-archive",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "new:demo": "node scripts/new-demo.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"scripts/*.mjs\" \"assets/*.js\" \"assets/*.css\" \"tests/**/*.mjs\" index.js index.html topic.html compare.html 404.html playwright.config.mjs catalog/schema.json package.json"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "ajv": "8.17.1",
    "prettier": "3.8.1"
  }
}
