# Dependencies (root tooling and independent demos)
node_modules/
.npm/
.pnpm-store/

# Intermediate builds and framework caches
# Pages publishes committed files, not these temporary output directories.
dist/
dist-ssr/
build/
.vite/
.next/
.nuxt/
.output/
.svelte-kit/
.astro/
.turbo/
.parcel-cache/
.cache/
*.tsbuildinfo

# Local deployment metadata (Vercel remains manually managed)
.vercel/
.netlify/

# Local environment settings; keep configuration templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Runtime logs and temporary process files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock

# Test reports and coverage; test source and fixtures stay tracked
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Go build outputs and local workspace configuration
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# Python demos: local environments and interpreter caches
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor-local files; shared VS Code configuration stays versioned
.idea/
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/tasks.json
**/.claude/
**/.cursor/
**/.windsurf/
**/.codex/
*.local
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
rename.bat

# Per-demo ignore files are replaced by the repository rule above.
**/.gitignore
!/.gitignore

# REQUIRED GitHub Pages outputs: commit these with source changes.
# Keep these exceptions last. Do not ignore the published site or its assets.
!/assets/generated/
!/assets/generated/**
!/previews/
!/previews/**
previews/**/rename.bat

# Keep lockfiles, catalog metadata, original prompts, docs, screenshots used
# as experiment evidence, .nojekyll, and AGENTS.md / CLAUDE.md versioned.
